{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@fhir-explorer/core": [
        "../../packages/core/src/index.ts"
      ],
      "@fhir-explorer/core/*": [
        "../../packages/core/src/*"
      ],
      "@fhir-explorer/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@fhir-explorer/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
