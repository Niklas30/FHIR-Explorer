{
  "name": "fhir-explorer",
  "displayName": "FHIR Explorer",
  "description": "Author FHIR profiles, value sets and examples directly in your workspace.",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "publisher": "fhir-explorer",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/sushi-config.yaml",
    "workspaceContains:**/sushi-config.yml",
    "workspaceContains:**/ig.ini",
    "workspaceContains:**/package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fhirExplorer",
          "title": "FHIR Explorer",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "fhirExplorer": [
        {
          "id": "fhirExplorer.projects",
          "name": "Projects",
          "icon": "media/activity-bar.svg"
        },
        {
          "id": "fhirExplorer.dependencies",
          "name": "Dependencies",
          "icon": "media/activity-bar.svg"
        },
        {
          "id": "fhirExplorer.packages",
          "name": "Imported Packages",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fhirExplorer.projects",
        "contents": "No FHIR project found in this workspace.\n\nA project is a folder with a sushi-config.yaml, an ig.ini, or a package.json carrying a FHIR manifest. Imported packages appear under Imported Packages and can be used as a starting point.\n\n[Create FHIR project](command:fhirExplorer.createProject)\n[Add FHIR dependency](command:fhirExplorer.addDependency)"
      },
      {
        "view": "fhirExplorer.dependencies",
        "contents": "No FHIR project found in this workspace.\n\n[Create FHIR project](command:fhirExplorer.createProject)"
      },
      {
        "view": "fhirExplorer.packages",
        "contents": "No FHIR packages imported yet.\n\nImport one to get profiles, value sets and validation.\n\n[Add dependency](command:fhirExplorer.addDependency)\n[Import package from file](command:fhirExplorer.importPackageFile)"
      }
    ],
    "commands": [
      {
        "command": "fhirExplorer.refresh",
        "title": "Refresh",
        "category": "FHIR Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "fhirExplorer.createProject",
        "title": "Create FHIR Project",
        "category": "FHIR Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhirExplorer.newResource",
        "title": "New Resource",
        "category": "FHIR Explorer",
        "icon": "$(add)"
      },
      {
        "command": "fhirExplorer.openResource",
        "title": "Open Resource",
        "category": "FHIR Explorer"
      },
      {
        "command": "fhirExplorer.deleteResource",
        "title": "Delete Resource",
        "category": "FHIR Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "fhirExplorer.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "FHIR Explorer"
      },
      {
        "command": "fhirExplorer.openInFormEditor",
        "title": "Open in FHIR Form Editor",
        "category": "FHIR Explorer",
        "icon": "$(preview)"
      },
      {
        "command": "fhirExplorer.addDependency",
        "title": "Add Dependency",
        "category": "FHIR Explorer",
        "icon": "$(add)"
      },
      {
        "command": "fhirExplorer.installDependencies",
        "title": "Install Dependencies",
        "category": "FHIR Explorer",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fhirExplorer.importPackageFile",
        "title": "Import Package from File",
        "category": "FHIR Explorer",
        "icon": "$(file-zip)"
      },
      {
        "command": "fhirExplorer.showDependencyGraph",
        "title": "Show Dependency Graph",
        "category": "FHIR Explorer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "fhirExplorer.installMissingDependency",
        "title": "Install This Dependency",
        "category": "FHIR Explorer",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fhirExplorer.browsePackages",
        "title": "Browse Imported Packages",
        "category": "FHIR Explorer",
        "icon": "$(library)"
      },
      {
        "command": "fhirExplorer.removeDependency",
        "title": "Remove Dependency",
        "category": "FHIR Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "fhirExplorer.updateDependency",
        "title": "Update Dependency",
        "category": "FHIR Explorer",
        "icon": "$(arrow-up)"
      },
      {
        "command": "fhirExplorer.createProjectFromPackage",
        "title": "Create Project Using This Package",
        "category": "FHIR Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhirExplorer.focusPackages",
        "title": "Show Imported Packages",
        "category": "FHIR Explorer"
      },
      {
        "command": "fhirExplorer.projectSettings",
        "title": "Project Settings",
        "category": "FHIR Explorer",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fhirExplorer.addDependency",
          "when": "view == fhirExplorer.projects",
          "group": "navigation@1"
        },
        {
          "command": "fhirExplorer.createProject",
          "when": "view == fhirExplorer.projects",
          "group": "navigation@2"
        },
        {
          "command": "fhirExplorer.refresh",
          "when": "view == fhirExplorer.projects",
          "group": "navigation@3"
        },
        {
          "command": "fhirExplorer.installDependencies",
          "when": "view == fhirExplorer.projects",
          "group": "1_install"
        },
        {
          "command": "fhirExplorer.importPackageFile",
          "when": "view == fhirExplorer.projects",
          "group": "1_install"
        },
        {
          "command": "fhirExplorer.showDependencyGraph",
          "when": "view == fhirExplorer.dependencies",
          "group": "navigation@1"
        },
        {
          "command": "fhirExplorer.addDependency",
          "when": "view == fhirExplorer.dependencies",
          "group": "navigation@2"
        },
        {
          "command": "fhirExplorer.installDependencies",
          "when": "view == fhirExplorer.dependencies",
          "group": "navigation@3"
        },
        {
          "command": "fhirExplorer.browsePackages",
          "when": "view == fhirExplorer.dependencies",
          "group": "1_browse"
        },
        {
          "command": "fhirExplorer.addDependency",
          "when": "view == fhirExplorer.packages",
          "group": "navigation@1"
        },
        {
          "command": "fhirExplorer.importPackageFile",
          "when": "view == fhirExplorer.packages",
          "group": "navigation@2"
        },
        {
          "command": "fhirExplorer.refresh",
          "when": "view == fhirExplorer.packages",
          "group": "navigation@3"
        },
        {
          "command": "fhirExplorer.projectSettings",
          "when": "view == fhirExplorer.projects",
          "group": "1_install"
        }
      ],
      "view/item/context": [
        {
          "command": "fhirExplorer.newResource",
          "when": "view == fhirExplorer.projects && viewItem == fhirExplorer.category",
          "group": "inline"
        },
        {
          "command": "fhirExplorer.deleteResource",
          "when": "view == fhirExplorer.projects && viewItem == fhirExplorer.resource",
          "group": "inline"
        },
        {
          "command": "fhirExplorer.revealInExplorer",
          "when": "view == fhirExplorer.projects && viewItem == fhirExplorer.resource",
          "group": "navigation"
        },
        {
          "command": "fhirExplorer.openInFormEditor",
          "when": "view == fhirExplorer.projects && viewItem == fhirExplorer.resource",
          "group": "navigation"
        },
        {
          "command": "fhirExplorer.installMissingDependency",
          "when": "view == fhirExplorer.dependencies && viewItem == fhirExplorer.missingDependency",
          "group": "inline"
        },
        {
          "command": "fhirExplorer.showDependencyGraph",
          "when": "view == fhirExplorer.dependencies && viewItem == fhirExplorer.dependencyRoot",
          "group": "inline"
        },
        {
          "command": "fhirExplorer.updateDependency",
          "when": "view == fhirExplorer.dependencies && viewItem == fhirExplorer.directDependency",
          "group": "inline@1"
        },
        {
          "command": "fhirExplorer.removeDependency",
          "when": "view == fhirExplorer.dependencies && viewItem == fhirExplorer.directDependency",
          "group": "inline@2"
        },
        {
          "command": "fhirExplorer.createProjectFromPackage",
          "when": "view == fhirExplorer.packages && viewItem == fhirExplorer.installedPackage",
          "group": "inline"
        },
        {
          "command": "fhirExplorer.projectSettings",
          "when": "view == fhirExplorer.projects && viewItem == fhirExplorer.project",
          "group": "inline"
        },
        {
          "command": "fhirExplorer.projectSettings",
          "when": "view == fhirExplorer.dependencies && viewItem == fhirExplorer.dependencyRoot",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "fhirExplorer.openResource",
          "when": "false"
        },
        {
          "command": "fhirExplorer.deleteResource",
          "when": "false"
        },
        {
          "command": "fhirExplorer.revealInExplorer",
          "when": "false"
        },
        {
          "command": "fhirExplorer.openInFormEditor",
          "when": "resourceExtname == .json"
        },
        {
          "command": "fhirExplorer.installMissingDependency",
          "when": "false"
        },
        {
          "command": "fhirExplorer.removeDependency",
          "when": "false"
        },
        {
          "command": "fhirExplorer.updateDependency",
          "when": "false"
        },
        {
          "command": "fhirExplorer.createProjectFromPackage",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "fhirExplorer.openInFormEditor",
          "when": "resourceExtname == .json && resourceDirname =~ /input\\\\/(capabilities|examples|extensions|models|operations|profiles|resources|testing|vocabulary)$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "FHIR Explorer",
      "properties": {
        "fhirExplorer.packageCache.useFhirHome": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Read from and write to the shared `~/.fhir/packages` cache, so the IG Publisher, Sushi and this extension reuse each other's downloads."
        },
        "fhirExplorer.registry.baseUrl": {
          "type": "string",
          "default": "https://packages2.fhir.org/packages",
          "markdownDescription": "Registry serving npm-style package metadata at `/{id}`. It must publish each version's `dependencies` \u2014 that is what lets the extension resolve the whole dependency tree before downloading anything."
        },
        "fhirExplorer.registry.searchUrl": {
          "type": "string",
          "default": "https://packages.fhir.org",
          "markdownDescription": "Registry serving `/catalog?op=find` for package search. Optional: without it, **Add Dependency** takes a package id typed by hand."
        },
        "fhirExplorer.terminologyServer.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional terminology server used to `$expand` value sets that the imported packages cannot expand. Leave empty to disable."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "fhirExplorer.formEditor",
        "displayName": "FHIR Form Editor",
        "selector": [
          {
            "filenamePattern": "**/input/capabilities/*.json"
          },
          {
            "filenamePattern": "**/input/examples/*.json"
          },
          {
            "filenamePattern": "**/input/extensions/*.json"
          },
          {
            "filenamePattern": "**/input/models/*.json"
          },
          {
            "filenamePattern": "**/input/operations/*.json"
          },
          {
            "filenamePattern": "**/input/profiles/*.json"
          },
          {
            "filenamePattern": "**/input/resources/*.json"
          },
          {
            "filenamePattern": "**/input/testing/*.json"
          },
          {
            "filenamePattern": "**/input/vocabulary/*.json"
          },
          {
            "filenamePattern": "**/fsh-generated/resources/*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "walkthroughs": [
      {
        "id": "fhirExplorer.gettingStarted",
        "title": "Get started with FHIR Explorer",
        "description": "Import the definitions you build on, create a project, and author against your own profiles.",
        "steps": [
          {
            "id": "import",
            "title": "Import a FHIR package",
            "description": "Validation needs StructureDefinitions. Start with hl7.fhir.r4.core \u2014 its dependencies come along.\n[Add Dependency](command:fhirExplorer.addDependency)",
            "media": {
              "markdown": "media/walkthrough/import.md"
            },
            "completionEvents": [
              "onContext:fhirExplorer.hasPackages"
            ]
          },
          {
            "id": "project",
            "title": "Create or open a project",
            "description": "A project is a folder with a FHIR manifest. Existing Sushi and IG Publisher repos are recognised as they are.\n[Create FHIR Project](command:fhirExplorer.createProject)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:fhirExplorer.hasProjects"
            ]
          },
          {
            "id": "author",
            "title": "Add a resource",
            "description": "Pick the profile an instance conforms to, then edit it as a form or as JSON.\n[New Resource](command:fhirExplorer.newResource)",
            "media": {
              "markdown": "media/walkthrough/author.md"
            },
            "completionEvents": [
              "onCommand:fhirExplorer.newResource"
            ]
          },
          {
            "id": "validate",
            "title": "See what the editor already knows",
            "description": "Problems, hover, go to definition and completion work on every resource file \u2014 no command needed.\n[Show Dependency Graph](command:fhirExplorer.showDependencyGraph)",
            "media": {
              "markdown": "media/walkthrough/validate.md"
            },
            "completionEvents": [
              "onCommand:fhirExplorer.showDependencyGraph"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs --production && vite build",
    "watch": "node build.mjs --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:webview": "vite build"
  },
  "dependencies": {
    "@fhir-explorer/core": "*",
    "@fhir-explorer/ui": "*",
    "jsonc-parser": "^3.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.96.0",
    "@vitejs/plugin-react": "^5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.5"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Niklas30/FHIR-Explorer.git"
  },
  "bugs": {
    "url": "https://github.com/Niklas30/FHIR-Explorer/issues"
  },
  "homepage": "https://github.com/Niklas30/FHIR-Explorer#readme",
  "keywords": [
    "fhir",
    "hl7",
    "healthcare",
    "structuredefinition",
    "implementation guide"
  ]
}
