{
  "name": "fhir-explorer-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fhir-explorer/web --",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @fhir-explorer/web",
    "lint": "eslint --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-sonarjs": "^4.0.3",
    "typescript": "^5"
  }
}
